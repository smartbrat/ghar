# Dependencies
node_modules/

# Claude Code — ignore everything under .claude/ by default, then unignore
# the team-shared config so teammates get the same hooks, permissions,
# statusline, brand-profile guard, and skill contract. Paths inside these
# files use $CLAUDE_PROJECT_DIR so they resolve on any machine.
.claude/*
!.claude/settings.json
!.claude/statusline.mjs
!.claude/hooks/
!.claude/hooks/**
!.claude/commands/
!.claude/commands/**
!.claude/skills/
.claude/skills/*
!.claude/skills/brand-profile-work/
!.claude/skills/brand-profile-work/**
# Personal / per-session state — never share
.claude/settings.local.json
.claude/worktrees/

# Personal / per-machine
.agents/
memory/
skills-lock.json

# Screenshots
screenshots/

# Playwright MCP artifacts (logs, page dumps)
.playwright-mcp/

# ── Non-production working files ──────────────────────────────────────────
# Everything that is not a shipped page or asset lives under _dev/ (archive,
# prototypes, reference, templates, tools, scratch). See _dev/README.md.
#
# EXCEPTION: _dev/templates/ + _dev/README.md ship. Templates are the
# source-of-truth documents a backend integrator reads to wire the same
# markup + [hidden]-section auto-hide to PHP/MySQL. To keep those two
# includable we can't blanket-ignore _dev/, so we list the throwaway
# subfolders individually instead.
#
# serve.mjs still resolves the local-only pages at their original root URL,
# so local review is unchanged.
_dev/archive/
_dev/prototypes/*
_dev/scratch/
_dev/state/
_dev/tools/*
_dev/reference/*
!_dev/reference/design-system.html
# Component library: generated page + manifest + index, and the per-component
# sources they are built from (npm run build:components).
!_dev/reference/components.html
!_dev/reference/components.json
!_dev/reference/COMPONENTS.md
!_dev/reference/components/
# Prototypes deliberately shipped to GitHub + Vercel for shared review /
# programmer handoff. Add a new negation line when a prototype is ready to
# share; old / superseded ones stay local (see 'ancient tests' list in the
# working tree that are intentionally NOT re-added).
!_dev/prototypes/brand-connect-horizon-preview.html
!_dev/prototypes/ds-brand-connect.html
!_dev/prototypes/about-editorial-demo.html
!_dev/prototypes/brand-flow.html
!_dev/prototypes/design-vertical-proposal.html
# Image optimiser tool — shipped so the programmer + AI pipeline can
# invoke it on the server. See docs/IMAGE-OPTIMIZATION.md.
!_dev/tools/convert-images.mjs

# Pages built but not yet routed for deploy. They live at the root because
# they are production-intent, not experiments; drop the entry once the page
# is wired into vercel.json.
buyers.html
brokers.html
developers.html
brand-partners.html

# Editor / OS backups. Belt and braces: these belong in _dev/archive/, but a
# stray one at the root must not slip into a commit either.
*.bak
*.html.bak
*-backup.html
*-backup.js
*-backup.css

# Unused media takes
videoworks-hero1.mp4

.vercel
