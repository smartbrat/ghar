    "search_results_person_row": {
      "id": "search_results_person_row",
      "path": "/search?q=…",
      "description": "Person results in the universal search.",
      "eligible_entity_types": ["person"],
      "context_inputs": ["query_terms"],
      "slots": {
        "organic": {
          "count": 10,
          "type": "organic",
          "ranking": "search_relevance_desc, portrait_first_desc"
        }
      }
    },

    "voices_speaker_index": {
