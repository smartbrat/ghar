        { "requires_real_portrait": true, "note": "VOICES-HANDOFF.md §4: never list a speaker without a real portrait" }
      ],
      "context_inputs": [],
      "slots": {
        "organic": {
          "count": 999,
          "type": "organic",
          "ranking": "voice_count_desc, recency_desc"
        }
      }
    }
  },

  "resolverContract": {
    "signature": "resolveEntitiesForSurface(surfaceId: string, context: SurfaceContext): { organic: Entity[], promoted: Entity[] }",
    "pseudocode": [
      "surface = surfaceRegistry[surfaceId]",
      "if !surface: throw UnknownSurfaceError",
      "organic = []; promoted = []",
      "for slotName in ['featured', 'promoted', 'organic']:",
      "  slot = surface.slots[slotName]",
      "  if !slot: continue",
      "  candidates = queryCandidates(surface.eligible_entity_types, surface.relationship_requirements, context)",
      "  if slot.requires_entitlement:",
      "    candidates = filter(candidates, has_entitlement(slot.requires_entitlement))",
      "  candidates = applyRanking(candidates, slot.ranking)",
      "  candidates = applyAdminPins(candidates, surfaceId)",
      "  candidates = applyAdminSuppressions(candidates, surfaceId)",
      "  candidates = candidates.slice(0, slot.count)",
      "  if slot.type == 'organic': organic.push(...candidates)",
      "  else: promoted.push(...candidates)",
      "return { organic, promoted }"
    ],
    "idempotent": "Running the resolver twice on (surfaceId, context) with unchanged data produces the same output. Required for caching."
  },

  "adminControls": {
    "pins": {
      "table": "distribution_surface_pins",
      "shape": "{ id, surface_id, entity_type, entity_id, slot_index, ttl_days?, created_by, created_at }",
      "description": "Force an entity into a specific slot on a surface. Highest priority — overrides ranking + entitlements."
    },
    "suppressions": {
      "table": "distribution_surface_suppressions",
      "shape": "{ id, surface_id, entity_type, entity_id, reason, ttl_days?, created_by, created_at }",
      "description": "Exclude an entity from a surface entirely. E.g. a brand whose story is currently under editorial review."
    },
    "priority_overrides": {
      "table": "distribution_surface_priority_overrides",
      "shape": "{ id, surface_id, entity_type, entity_id, boost_score, ttl_days?, created_by, created_at }",
      "description": "Nudge an entity's rank up or down. Additive to base ranking."
    }
  },

  "rankingRuleVocabulary": {
    "description": "Every 'ranking' string above resolves to a small vocabulary of sort predicates.",
    "predicates": {
      "featured_desc": "boolean; entities with featured=true first",
      "featured_pin_asc": "editor-pinned entities first, in pin_order",
      "package_tier_desc": "highest package tier first (Partner > Spotlight > Presence > null)",
      "recency_desc": "updated_at DESC",
      "name_asc": "alphabetical by name",
      "portrait_first_desc": "people with real portraits before monogram-only",
      "published_at_desc": "latest content publication DESC",
      "shared_project_count_desc": "count of shared projects DESC",
      "is_leadership_desc": "leadership relationships first",
      "is_lead_desc": "is_lead=true first",
      "display_order_asc": "explicit display_order ASC",
      "role_asc": "alphabetical by role",
      "delivered_project_count_desc": "count of delivered projects DESC",
      "search_relevance_desc": "search index score DESC",
      "editorial_priority_desc": "admin-set editorial_priority DESC",
      "voice_count_desc": "count of voice entries authored by person DESC",
      "last_featured_at_asc": "surfaces this hasn't been featured recently",
      "city_relevance_desc": "viewer's city match DESC",
      "mention_kind_priority": "subject > author > callout > tag > quoted"
    }
  }
}
