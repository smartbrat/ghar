          "type": "promoted",
          "requires_entitlement": "premium_distribution",
          "ranking": "package_tier_desc, published_at_desc",
          "position": "top"
        },
        "organic": {
          "count": 6,
          "type": "organic",
          "ranking": "portrait_first_desc, published_at_desc"
        }
      }
    },

    "locality_page_developers": {
      "id": "locality_page_developers",
      "path": "/{city_slug}/{locality_slug}#developers",
      "description": "Developer brands with delivered or in-construction projects in the locality.",
      "eligible_entity_types": ["brand"],
      "relationship_requirements": [
        { "primary_category": "developer" },
        { "source": "brand_project_relationships", "role": "developer", "join_project_in_locality": true }
      ],
      "context_inputs": ["city_slug", "locality_slug"],
      "slots": {
        "featured": {
          "count": 4,
          "type": "promoted",
          "requires_entitlement": "category_priority",
          "position": "top"
        },
        "organic": {
          "count": 12,
          "type": "organic",
          "ranking": "delivered_project_count_desc, package_tier_desc"
        }
      }
    },

    "article_page_recirculation_by_entity": {
      "id": "article_page_recirculation_by_entity",
      "path": "/design/{article_slug}#more-from",
      "description": "'More from {brand}' / 'More by {person}' at the end of an article body.",
      "eligible_entity_types": ["article"],
      "relationship_requirements": [
        { "source": "article_entity_mentions", "shares_mentioned_entity_with_current_article": true },
        { "exclude_current_article": true }
      ],
