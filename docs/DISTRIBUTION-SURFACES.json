      "path": "/#hp-people",
      "description": "Featured people on the homepage.",
      "eligible_entity_types": ["person"],
      "context_inputs": [],
      "slots": {
        "featured": {
          "count": 6,
          "type": "promoted",
          "requires_entitlement": "homepage_placement",
          "ranking": "package_tier_desc"
        },
        "organic": {
          "count": 6,
          "type": "organic",
          "ranking": "portrait_first_desc, published_at_desc"
        }
      }
    },

    "newsletter_brand_spotlight": {
      "id": "newsletter_brand_spotlight",
      "path": "newsletter",
      "description": "Featured brand in the weekly Ghar.tv newsletter.",
      "eligible_entity_types": ["brand"],
      "context_inputs": ["issue_date"],
      "slots": {
        "featured": {
          "count": 1,
          "type": "promoted",
          "requires_entitlement": "newsletter_distribution",
          "ranking": "package_tier_desc, last_featured_at_asc"
        }
      }
    },

    "search_results_brand_row": {
      "id": "search_results_brand_row",
      "path": "/search?q=…",
      "description": "Brand results in the universal search.",
      "eligible_entity_types": ["brand"],
      "context_inputs": ["query_terms"],
      "slots": {
        "organic": {
          "count": 10,
          "type": "organic",
          "ranking": "search_relevance_desc, featured_desc"
        }
