      "eligible_entity_types": ["brand"],
      "context_inputs": ["viewer_city?"],
      "slots": {
        "featured": {
          "count": 8,
          "type": "promoted",
          "requires_entitlement": "homepage_placement",
          "ranking": "package_tier_desc, recency_desc, city_relevance_desc"
        },
        "organic": {
          "count": 4,
          "type": "organic",
