    "project_page_people_involved": {
      "id": "project_page_people_involved",
      "path": "/projects/{project_slug}#people",
      "description": "All people with a role on the current project (typically principal architect, lead designer).",
      "eligible_entity_types": ["person"],
      "relationship_requirements": [
        { "source": "person_project_relationships", "project_id_matches": true }
      ],
      "context_inputs": ["current_project_id"],
      "slots": {
        "organic": {
          "count": 6,
          "type": "organic",
          "ranking": "is_lead_desc, display_order_asc"
        }
