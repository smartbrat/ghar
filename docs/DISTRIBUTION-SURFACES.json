{
  "$schema": "ghar.tv distribution-surfaces spec v1",
  "name": "Ghar.tv distribution surface registry",
  "version": "1.0.0",
  "lastUpdated": "2026-08-31",
  "description": "Every surface across the portal where entity cards (brand / person / project / product) appear. Not the profile pages themselves — those are composed via PROFILE-SECTIONS-SPEC.json. This is the reverse: where entities SURFACE on N pages OTHER than their own profile. One resolver — resolveEntitiesForSurface(surface_id, context) — powers every entity card. Editors NEVER manually place entity cards.",

  "globalRules": {
    "resolver": "resolveEntitiesForSurface(surface_id, context) → { organic: [Entity], promoted: [Entity] }",
    "slotTypes": {
      "organic": "Relationship-driven. Ranked by relationship strength + editorial signals. Free.",
      "promoted": "Package-gated. Requires an entitlement. Ranked by package tier + recency.",
      "featured": "Editor-pinned. Manual override — takes precedence over both organic + promoted."
    },
    "adminControls": {
      "pin": "Force a specific entity into a slot. Highest priority.",
      "suppress": "Exclude an entity from this surface entirely.",
      "priority_override": "Nudge an entity's rank up or down. Additive to the base ranking."
    },
    "attributionRule": "Distribution NEVER violates content attribution. A person profile card does NOT surface on a brand's page just because the person works there — the relationship must be typed 'featured' or 'leadership' or 'founder'.",
    "entitlementRule": "'requires_entitlement' fields gate PROMOTED slots. Organic slots are always free.",
    "cacheKey": "surface_id + context.viewer_type + context.entity_context_hash",
    "cacheTtl": "5 minutes"
  },

  "surfaces": {

    "brand_directory": {
      "id": "brand_directory",
      "path": "/brands",
      "renders_in": "brands.html",
      "description": "The main brand directory. Filter by category / city / locality / recognition / name.",
      "eligible_entity_types": ["brand"],
      "relationship_requirements": [
        { "field_match": { "brands.status": "published" } }
      ],
      "context_inputs": ["category_filter?", "city_filter?", "locality_filter?", "recognition_filter?", "search_query?"],
      "slots": {
        "featured": {
          "count": 4,
          "type": "promoted",
          "requires_entitlement": "category_priority",
          "ranking": "featured_pin_asc, package_tier_desc, recency_desc",
          "position": "top"
        },
        "organic": {
          "count": 96,
          "type": "organic",
          "ranking": "featured_desc, name_asc",
          "pagination": true,
          "page_size": 24
        }
      },
      "empty_state": "No brands match your filters. [Reset filters] or [Suggest a brand]"
    },

    "person_directory": {
      "id": "person_directory",
      "path": "/people",
      "renders_in": "people.html",
      "description": "The main person directory. Filter by discipline / city / name.",
      "eligible_entity_types": ["person"],
      "relationship_requirements": [
        { "field_match": { "people.status": "published" } },
        { "requires_portrait_or_monogram": true, "note": "Per feedback_no_person_without_portrait — never list a person without a real portrait or a Gazpacho monogram" }
      ],
      "context_inputs": ["discipline_filter?", "city_filter?", "search_query?"],
      "slots": {
        "featured": {
          "count": 3,
          "type": "promoted",
          "requires_entitlement": "premium_distribution",
          "ranking": "featured_pin_asc, package_tier_desc",
          "position": "top"
        },
        "organic": {
          "count": 96,
          "type": "organic",
          "ranking": "portrait_first_desc, published_at_desc, name_asc",
          "pagination": true,
          "page_size": 24
        }
      },
      "empty_state": "No people match your filters. [Reset filters]"
    },

    "brand_page_related_brands": {
      "id": "brand_page_related_brands",
      "path": "/brands/{brand_slug}#related",
      "renders_via": "PROFILE-SECTIONS-SPEC.json related.brand_variants.same_project_brands",
      "description": "Brands that worked on the same projects as the current brand.",
      "eligible_entity_types": ["brand"],
      "relationship_requirements": [
        { "source": "brand_project_relationships", "same_project_as_current_brand": true },
        { "exclude_current_brand": true }
      ],
      "context_inputs": ["current_brand_id"],
      "slots": {
        "organic": {
          "count": 4,
          "type": "organic",
          "ranking": "shared_project_count_desc, recency_desc"
        }
      }
    },

    "brand_page_similar_brands": {
      "id": "brand_page_similar_brands",
      "path": "/brands/{brand_slug}#similar",
      "renders_via": "PROFILE-SECTIONS-SPEC.json related.brand_variants.same_category_brands",
      "description": "Brands in the same category as the current brand.",
      "eligible_entity_types": ["brand"],
      "relationship_requirements": [
        { "same_primary_category_as_current_brand": true },
        { "exclude_current_brand": true }
      ],
      "context_inputs": ["current_brand_id"],
      "slots": {
        "organic": {
          "count": 4,
          "type": "organic",
          "ranking": "featured_desc, recency_desc"
        }
      }
    },

    "person_page_also_at_brand": {
      "id": "person_page_also_at_brand",
      "path": "/people/{person_slug}#related",
      "renders_via": "PROFILE-SECTIONS-SPEC.json related.person_variants.co_workers",
      "description": "Co-workers at the person's current primary brand.",
      "eligible_entity_types": ["person"],
      "relationship_requirements": [
        { "source": "brand_person_relationships", "same_brand_as_current_person": true, "current_only": true },
        { "exclude_current_person": true }
      ],
      "context_inputs": ["current_person_id"],
      "slots": {
        "organic": {
          "count": 3,
          "type": "organic",
          "ranking": "is_leadership_desc, display_order_asc"
        }
      }
    },

    "person_page_similar_discipline": {
      "id": "person_page_similar_discipline",
      "path": "/people/{person_slug}#similar",
      "renders_via": "PROFILE-SECTIONS-SPEC.json related.person_variants.similar_discipline",
      "description": "People in the same discipline + same city as the current person. For people without a linked brand.",
      "eligible_entity_types": ["person"],
      "relationship_requirements": [
        { "same_primary_discipline_as_current_person": true },
        { "same_city_as_current_person": true },
        { "exclude_current_person": true }
      ],
      "context_inputs": ["current_person_id"],
      "slots": {
        "organic": {
          "count": 4,
          "type": "organic",
          "ranking": "portrait_first_desc, published_at_desc"
        }
      }
    },

    "project_page_brands_involved": {
      "id": "project_page_brands_involved",
      "path": "/projects/{project_slug}#brands",
      "description": "All brands with a role on the current project.",
      "eligible_entity_types": ["brand"],
      "relationship_requirements": [
        { "source": "brand_project_relationships", "project_id_matches": true }
      ],
      "context_inputs": ["current_project_id"],
      "slots": {
        "organic": {
          "count": 12,
          "type": "organic",
          "ranking": "role_asc, is_lead_desc, display_order_asc",
          "grouping_by_role": true
