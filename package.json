{
  "type": "module",
  "scripts": {
    "build:tailwind": "tailwindcss -i ./src/tailwind.css -o ./dist/tailwind.css --minify",
    "watch:tailwind": "tailwindcss -i ./src/tailwind.css -o ./dist/tailwind.css --watch",
    "build:styles": "esbuild styles.css --minify --outfile=dist/styles.min.css",
    "build:js": "esbuild main.js --minify --outfile=dist/main.min.js",
    "build:partials": "node scripts/build-partials.mjs",
    "build": "npm run images:audit && npm run build:partials && npm run build:tailwind && npm run build:styles && npm run build:js",
    "build:people": "node scripts/build-person-profiles.mjs",
    "build:components": "node scripts/build-components.mjs",
    "images": "npm run images:fix && npm run images:audit",
    "images:fix": "node scripts/images.mjs localize && npm run images:convert && node scripts/images.mjs apply && node scripts/images.mjs probe && node scripts/images.mjs apply",
    "images:convert": "node _dev/tools/convert-images.mjs brand_assets kit-assets",
    "images:audit": "node scripts/images.mjs audit --strict --summary",
    "images:report": "node scripts/images.mjs audit --all --summary"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "esbuild": "^0.28.0",
    "photoswipe": "^5.4.4",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.19"
  },
  "dependencies": {
    "ws": "^8.21.0"
  }
}
